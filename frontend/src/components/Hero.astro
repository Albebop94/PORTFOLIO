---
---
<section class="hero container">
  <div class="hero-content glass-panel">
    <h1>Senior <span class="highlight">Sysadmin</span> & <span class="highlight">DevOps</span> Engineer</h1>
    <p class="subtitle">Over 10 years of experience building, automating, and maintaining resilient, high-availability architectures.</p>
    <div class="cta-buttons">
      <a href="#tech-stack" class="btn btn-primary">Explore My Stack</a>
      <a href="https://github.com/Albebop94" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GitHub Profile</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 4rem;
  }
  .hero-content {
    text-align: center;
    max-width: 800px;
    animation: fadeIn 1s ease-out;
  }
  h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.05em;
  }
  .highlight {
    color: var(--accent-cyan);
    text-shadow: 0 0 10px rgba(102, 252, 241, 0.3);
  }
  .subtitle {
    font-size: 1.25rem;
    color: #a0a0a0;
    margin-bottom: 2rem;
  }
  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .btn-primary {
    background: var(--accent-cyan);
    color: var(--bg-color);
    box-shadow: 0 4px 15px rgba(102, 252, 241, 0.4);
  }
  .btn-primary:hover {
    background: var(--accent-cyan-dark);
    color: white;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: transparent;
    color: var(--text-heading);
    border: 1px solid var(--glass-border);
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @media (max-width: 768px) {
    h1 { font-size: 2.5rem; }
    .cta-buttons { flex-direction: column; }
  }
</style>
